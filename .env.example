# NEVER COMMIT REAL SECRETS TO YOUR .env FILE
# Copy this file to .env and fill in real values.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gcc_car_value
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/gcc_car_value
S3_BUCKET=gcc-car-value-raw-dev
S3_ENDPOINT_URL=http://localhost:4566
ENVIRONMENT=development
SECRET_PROVIDER=environment
LOG_LEVEL=DEBUG

# Comma-separated frontend origins allowed to call the API from browsers.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# REQUIRED: JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional: External API keys
# CLAUDE_API_KEY=
# VIN_API_KEY=
