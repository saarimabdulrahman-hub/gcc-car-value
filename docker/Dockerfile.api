FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser -s /bin/false appuser

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

COPY pyproject.toml .
COPY src/ src/

# Production dependencies only — dev tooling (pytest/mypy/ruff) is not shipped.
RUN pip install --no-cache-dir .

# Create app directory for the non-root user
RUN mkdir -p /app/data && chown -R appuser:appuser /app

ENV ALEMBIC_CONFIG=src/db/migrations/alembic.ini

EXPOSE 8000

USER appuser

# Fail fast: a failed migration must stop the deployment, not start the app on
# a stale/incompatible schema. `exec` replaces the shell so uvicorn (PID 1)
# receives SIGTERM/SIGINT for graceful shutdown.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn src.api.main:app --host 0.0.0.0 --port 8000"]

# Container-level health check (used by docker-compose and platforms that honor
# it; Render uses render.yaml healthCheckPath instead).
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://localhost:8000/v1/health/live || exit 1
